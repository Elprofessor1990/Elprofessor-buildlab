---
import { subjects } from "../data/subjects";
import { videos } from "../data/videos";
import { getLocalePath, ui, type Locale } from "../i18n";

const { locale } = Astro.props as { locale: Locale };
const copy = ui[locale];
---

<section class="section section--subjects" id="subjects" aria-labelledby="subjects-title">
  <div class="section__header">
    <p class="eyebrow">{copy.tagline}</p>
    <h2 id="subjects-title">{copy.home.subjectsTitle}</h2>
    <p>{copy.home.subjectsText}</p>
  </div>

  <div class="subject-grid">
    {subjects.map((subject, index) => {
      const videoCount = videos.filter((video) => video.subject === subject.slug).length;

      return (
        <a class="subject-card subject-card--link" href={getLocalePath(locale, "subject", subject.slug)}>
          <span class="subject-card__number">{String(index + 1).padStart(2, "0")}</span>
          <h3>{subject.title[locale]}</h3>
          <p>{subject.description[locale]}</p>
          <span class="subject-card__action">
            {copy.actions.openSubject}
            <small>{videoCount} {copy.subjectPage.videoCount}</small>
          </span>
        </a>
      );
    })}
  </div>
</section>

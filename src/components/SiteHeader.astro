---
import { getAssetPath, getLocalePath, ui, withBase, type Locale, type PageKey } from "../i18n";

type Props = {
  locale: Locale;
  currentPage: PageKey | "plugin" | "bygfys-suite";
};

const { locale, currentPage } = Astro.props;
const copy = ui[locale];
const logoUrl = getAssetPath("assets/logo-ldb.png");
const pluginLabel = {
  da: "Revit-plugin",
  en: "Revit plugin",
  ar: "إضافة Revit",
}[locale];
const buildingPhysicsSuiteLabel = {
  da: "Bygfys-suite",
  en: "Building Physics Suite",
  ar: "حزمة فيزياء المباني",
}[locale];

const navItems = [
  { label: copy.nav.subjects, href: `${getLocalePath(locale, "home")}#subjects`, key: "subjects" },
  { label: copy.nav.videos, href: getLocalePath(locale, "videos"), key: "videos" },
  { label: buildingPhysicsSuiteLabel, href: withBase("/bygningsfysik-suite"), key: "bygfys-suite" },
  { label: pluginLabel, href: withBase("/install-plugin"), key: "plugin" },
  { label: copy.nav.about, href: getLocalePath(locale, "about"), key: "about" },
];
---

<header class="site-header">
  <a class="brand-link" href={getLocalePath(locale, "home")} aria-label={copy.brand}>
    <img src={logoUrl} alt="" width="44" height="44" />
    <span>
      <strong>{copy.brand}</strong>
      <small>{copy.tagline}</small>
    </span>
  </a>

  <nav class="main-nav" aria-label="Main navigation">
    {navItems.map((item) => (
      <a
        href={item.href}
        aria-current={(
          currentPage === item.key ||
          (currentPage === "home" && item.key === "subjects") ||
          (currentPage === "subject" && item.key === "subjects") ||
          (currentPage === "video" && item.key === "videos")
        ) ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

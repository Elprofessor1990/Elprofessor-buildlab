---
import { learningTracks } from "../data/learningTracks";
import { getLocalePath, ui, withBase, type Locale } from "../i18n";

const { locale } = Astro.props as { locale: Locale };
const copy = ui[locale];
---

<section class="hero">
  <div class="hero__media" aria-hidden="true"></div>
  <div class="hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{copy.home.eyebrow}</p>
      <h1>{copy.home.title}</h1>
      <p class="hero__intro">{copy.home.intro}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={getLocalePath(locale, "videos")}>{copy.actions.viewVideos}</a>
        <a class="button button--quiet" href="#subjects">{copy.actions.exploreSubjects}</a>
      </div>
      <a class="hero-plugin-cta" href={withBase("/install-plugin")}>
        <span class="hero-plugin-cta__eyebrow">Ny Revit-udvidelse</span>
        <strong>Installer Revit MCP + NBS Nordic</strong>
        <small>Download plugin og se opsætning →</small>
      </a>
    </div>

    <div class="hero-topic-board" aria-label={copy.home.heroTracksLabel}>
      {learningTracks.map((track) => (
        <a href={getLocalePath(locale, "subject", track.primarySubject)}>
          <span>{track.title[locale]}</span>
          <small>{track.label[locale]}</small>
        </a>
      ))}
    </div>
  </div>
</section>

---
import { getAssetPath, getLocalePath } from "../i18n";

const installerUrl = getAssetPath("downloads/Bygningsfysik-suite-Setup-2.2.0.exe");
const itslearningLoginUrl = "https://ek.itslearning.com/";
const checksum = "0D4CA67F2A3EA8BA18AF6E0D8EE51AA271D8B266B28AC68F7BBA528B1E1F45EB";
---

<article class="suite-page">
  <header class="suite-hero">
    <div class="suite-hero__copy">
      <p class="eyebrow">Bygningsfysik · Windows-værktøj</p>
      <div class="suite-status"><span aria-hidden="true"></span> Aktuel version</div>
      <h1>Bygningsfysik-suite <em>2.2.0</em></h1>
      <p class="suite-hero__lead">
        Hent installationsfilen direkte fra Elprofessor BuildLab. Du behøver ikke åbne Itslearning for at downloade
        denne version.
      </p>
      <div class="hero__actions">
        <a class="button button--primary suite-download-button" href={installerUrl} download>
          <span>Download til Windows</span>
          <small>Version 2.2.0 · 49,4 MB · .exe</small>
        </a>
        <a class="button button--quiet" href={`${getLocalePath("da", "home")}#subjects`}>Se alle emner</a>
      </div>
    </div>

    <div class="suite-version-panel" aria-label="Versionsoplysninger">
      <span class="suite-version-panel__label">BYGFYS</span>
      <strong>2.2</strong>
      <div class="suite-version-panel__signals" aria-hidden="true">
        <span>°C</span><span>RH</span><span>dB</span>
      </div>
      <p>Varme · Fugt · Lyd</p>
    </div>
  </header>

  <div class="suite-content">
    <section class="suite-steps" aria-labelledby="suite-steps-title">
      <p class="eyebrow">Sådan gør du</p>
      <h2 id="suite-steps-title">Fra download til installation</h2>
      <ol>
        <li>
          <span>01</span>
          <div><strong>Download filen</strong><p>Klik på den orange knap ovenfor, og gem installationsfilen.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><strong>Kontrollér filnavnet</strong><p>Filen skal hedde <code>Bygningsfysik-suite-Setup-2.2.0.exe</code>.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><strong>Start installationen</strong><p>Åbn filen i Windows, og følg trinnene i installationsvinduet.</p></div>
        </li>
      </ol>
    </section>

    <aside class="suite-file-card" aria-labelledby="suite-file-title">
      <p class="eyebrow">Filoplysninger</p>
      <h2 id="suite-file-title">Installationsfil</h2>
      <dl>
        <div><dt>Version</dt><dd>2.2.0</dd></div>
        <div><dt>Platform</dt><dd>Windows</dd></div>
        <div><dt>Størrelse</dt><dd>49,4 MB</dd></div>
        <div><dt>Format</dt><dd>.exe</dd></div>
      </dl>
      <div class="suite-checksum">
        <strong>SHA-256</strong>
        <code>{checksum}</code>
      </div>
      <a class="button button--primary" href={installerUrl} download>Download version 2.2.0</a>
    </aside>
  </div>

  <section class="suite-alternative" aria-labelledby="itslearning-guide-title">
    <div class="suite-alternative__intro">
      <p class="eyebrow">Itslearning · kræver login</p>
      <h2 id="itslearning-guide-title">Her ligger den nyeste version</h2>
      <p>
        Det gamle direkte mappelink kan give fejl 403, fordi mappen kun virker med en aktiv Itslearning-session.
        Log ind på Itslearning først, og følg derefter stien her.
      </p>
      <a class="button button--quiet" href={itslearningLoginUrl} target="_blank" rel="noopener">Gå til Itslearning-login</a>
    </div>

    <div class="itslearning-route" aria-label="Vej til den nyeste version i Itslearning">
      <ol>
        <li><span>1</span><div><strong>Log ind</strong><small>Åbn Itslearning med din EK-konto.</small></div></li>
        <li><span>2</span><div><strong>Projektering BIM</strong><small>Vælg rummet fra oversigten.</small></div></li>
        <li><span>3</span><div><strong>Ressourcer</strong><small>Åbn fanen øverst i rummet.</small></div></li>
        <li><span>4</span><div><strong>BYGFYS</strong><small>Åbn mappen i ressourcelisten.</small></div></li>
        <li><span>5</span><div><strong>Nyeste version</strong><small>Vælg filen med det højeste versionsnummer.</small></div></li>
      </ol>
      <p class="itslearning-route__note"><strong>Fremover:</strong> Den nyeste version vil ligge i BYGFYS-mappen.</p>
    </div>
  </section>
</article>

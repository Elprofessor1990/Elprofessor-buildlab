      { msg: "[-] Lokal installation fejlede: Backup hash mismatch: <sti>", sev: "fejl", means: "Backuppen af en eksisterende fil kunne ikke bekræftes (disk eller antivirus).", todo: "Kør igen, og tjek diskplads og antivirus." },
      { msg: "[-] Lokal installation fejlede: Installed hash mismatch: <sti>", sev: "fejl", means: "Den kopierede fil matcher ikke originalen. Allerede kopierede filer rulles tilbage.", todo: "Kør igen, og tjek antivirus." },
      { msg: "[-] Lokal installation fejlede: <Windows-fejltekst, fx adgang nægtet eller fil i brug>", sev: "fejl", means: "En filsystemfejl fra Windows.", todo: "Luk Revit, og kør igen. Send et skærmbillede, hvis fejlen gentager sig." },
    ],

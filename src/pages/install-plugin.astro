              <div class="ip-group__body">
                {group.intro && <p class="ip-group-intro">{group.intro}</p>}
                <div class="ip-msgs">
                  {group.items.map((m) => (
                    <details class="ip-msg">
                      <summary>
                        <span class={`ip-sev ip-sev--${m.sev}`}>{sevLabel[m.sev]}</span>{" "}
                        <code>{m.msg}</code>
                      </summary>
                      <dl>

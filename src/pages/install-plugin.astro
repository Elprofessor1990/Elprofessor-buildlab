  { k: "plain", t: rule },
  { k: "plain", t: "    ISSANA - Revit MCP + NBS Nordic" },
  { k: "plain", t: "    Udviklet af ISSANA - Raadgivende Ingenioerer" },
  { k: "plain", t: "    Byg og Miljo Raadgiver ApS" },
  { k: "plain", t: rule },
  { k: "plain", t: "" },
  { k: "plain", t: "  Installerer / Installing..." },
  { k: "plain", t: "" },
  { k: "plain", t: "" },
  { k: "banner", t: rule },
  { k: "banner", t: `      ISSANA  --  Revit MCP + NBS Nordic  v${pluginVersion}` },
  { k: "banner2", t: "      Udviklet af ISSANA - Rådgivende Ingeniører" },
  { k: "banner2", t: "      Byg og Miljø Rådgiver ApS" },

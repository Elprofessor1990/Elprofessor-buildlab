                    <div class="ip-code">
                      <div class="ip-code__bar">
                        <span>Prompt</span>
                        <button type="button" class="ip-copy" data-copy={`prompt-${ex.n}`} aria-label={`Kopiér prompten til øvelsen ${ex.title}`} hidden>Kopiér</button>
                      </div>
                      <pre><code id={`prompt-${ex.n}`}>{ex.prompt}</code></pre>
                    </div>
                    <details class="ip-ex__more">
                      <summary>Forventet resultat og sikkerhed</summary>
                      <p><strong>Forventet resultat:</strong> {ex.expected}</p>
                      <p><strong>Sikkerhed:</strong> {ex.safety}</p>
                    </details>
                  </article>
                ))}
              </div>
            </Wrap>

            <details class="ip-msg">
              <summary>
                <span class={`ip-sev ip-sev--${m.sev}`}>{sevLabel[m.sev]}</span>{" "}
                <code>{m.msg}</code>
              </summary>
              <dl>
                {m.where && (<><dt>Hvor</dt><dd>{m.where}</dd></>)}
                <dt>Betyder</dt>
                <dd>{m.means}</dd>
                <dt>Gør sådan</dt>
                <dd>{m.todo}</dd>
              </dl>
            </details>
          ))
        }
      </div>

      <p class="ip-group-lead">Øvrige beskeder, sorteret efter hvor de vises (de fire almindelige står ovenfor). Klik på en gruppe for at åbne den.</p>
      <div class="ip-groups">
        {
          messageGroups.map((group) => (
            <details class="ip-group" id={group.id}>
              <summary>
                <h3>{group.title}</h3>
                <span class="ip-count">{group.items.length} beskeder</span>

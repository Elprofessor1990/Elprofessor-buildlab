      { msg: "[!] <Klient>: Sat op, men kræver opmærksomhed -- <engelsk advarsel>", sev: "advarsel", means: "Konfigurationen er skrevet, men med en advarsel (p.t. kun service_tier i Codex).", todo: "Læs advarslen, og se punktet om service_tier ovenfor." },

      }
    </section>

    <!-- Manuel opsætning -->
    <details class="ip-section ip-manual" id="manuel">
      <summary><h2>Manuel opsætning (kun hvis installeren ikke kunne)</h2></summary>
      <div class="ip-manual__body">
        <p>
          Normalt skal du ikke røre konfigurationsfilerne: installeren sætter alle fundne AI-apps op og tager backup af eksisterende
          filer. Kør hellere installationsfilen igen (vælg <kbd>R</kbd>), og kontrollér med <code>claude mcp get revit-mcp-nbs</code> eller{" "}
          <code>codex mcp list</code>.
        </p>
        <dl class="ip-facts">
          <div><dt>Servernavn</dt><dd><code>revit-mcp-nbs</code></dd></div>
          <div><dt>command</dt><dd>Den fulde sti til node.exe, fx <code>{paths.node}</code></dd></div>
          <div><dt>args</dt><dd><code>{serverPathExample}</code> (brug <code>2026</code> i stien til Revit 2026)</dd></div>
          <div><dt>Claude Desktop</dt><dd><code>{paths.claudeDesktop}</code> under <code>mcpServers</code> (Store-udgaven: <code>{paths.claudeStore}</code>)</dd></div>
          <div><dt>Claude Code</dt><dd><code>{paths.claudeCode}</code> under <code>mcpServers</code></dd></div>
          <div><dt>Codex</dt><dd><code>{paths.codex}</code> som tabellen <code>[mcp_servers.revit-mcp-nbs]</code></dd></div>
        </dl>
        <p>I JSON-filer skal hver <code>{backslash}</code> skrives dobbelt, og <code>%APPDATA%</code> skal skrives helt ud:</p>
        <h3 class="ip-sub">Claude Desktop og Claude Code (JSON, inde i <code>mcpServers</code>)</h3>
        <pre class="ip-pre"><code>{manualJson}</code></pre>
        <h3 class="ip-sub">Codex (TOML)</h3>
        <pre class="ip-pre"><code>{manualToml}</code></pre>
        <p>Genstart AI-appen bagefter.</p>
      </div>
    </details>

    <footer class="ip-foot">
      <p>
        Version {pluginVersion} · <time datetime={releaseDateIso}>{releaseDate}</time> · udviklet af {issana}
      </p>
      <a class="ip-foot__link" href={architectureUrl}>Teknisk overblik (arkitekturdiagram)</a>
    </footer>

    <p class="ip-sr" id="ip-copy-status" aria-live="polite"></p>
  </div>
</BaseLayout>

<script>
  const status = document.getElementById("ip-copy-status");

  if (navigator.clipboard && window.isSecureContext) {
    document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((button) => {
      const label = button.textContent ?? "Kopiér";
      button.hidden = false;
      button.addEventListener("click", async () => {
        const target = document.getElementById(button.dataset.copy ?? "");
        if (!target) return;
        try {
          await navigator.clipboard.writeText((target.textContent ?? "").trim());
          button.textContent = "Kopieret";
          if (status) status.textContent = "Prompten er kopieret.";
        } catch {
          button.textContent = "Kunne ikke kopiere";
        }
        window.setTimeout(() => {
          button.textContent = label;
        }, 2000);
      });
    });
  }

  const openFromHash = () => {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) target.open = true;
  };
  openFromHash();
  window.addEventListener("hashchange", openFromHash);
</script>


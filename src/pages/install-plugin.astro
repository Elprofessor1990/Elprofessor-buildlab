/* ---------- Fejlmeddelelser ---------- */
type Sev = "fejl" | "advarsel" | "info" | "dialog";
type Msg = { msg: string; sev: Sev; where?: string; means: string; todo: string };
type MsgGroup = { id: string; title: string; intro?: string; items: Msg[] };

const sevLabel: Record<Sev, string> = { fejl: "Fejl", advarsel: "Advarsel", info: "Info", dialog: "Dialog" };

const commonMessages: Msg[] = [
  {
    msg: "[-] Lokal installation fejlede: Gem og luk Revit før installationen. Ingen Addins-filer er ændret.",
    sev: "fejl",
    where: "TRIN 5",
    means: "Revit kører stadig – måske skjult eller hængt. Installeren rører derfor ingen filer.",
    todo: "Gem og luk Revit. Tjek i Jobliste, at der ikke kører en Revit.exe, og kør installationsfilen igen.",
  },
  {
    msg: "[!] Node.js ikke fundet (system eller medfølgende)",
    sev: "advarsel",
    where: "TRIN 4",
    means: "Node.js (kræves af MCP-serveren) er ikke installeret, eller kommandoen node findes ikke. Node.js følger ikke med installationsfilen.",
    todo: "Vælg [1] i menuen, der kommer lige efter. Godkend Windows' administratorspørgsmål (UAC), og gennemfør Node.js-guiden med standardvalg.",
  },
  {
    msg: "[-] Kan ikke nå api.github.com  --  tjek din forbindelse eller proxy.",
    sev: "fejl",
    where: "TRIN 1",
    means: "Installeren tester internetforbindelsen ved at kontakte api.github.com (højst 10 sekunder). Der hentes intet fra GitHub – det er kun en forbindelsestest – men installationen stopper, hvis testen fejler.",
    todo: "Tjek internet, firewall, proxy og VPN. Prøv evt. et andet net (fx et mobil-hotspot), og kør installationsfilen igen.",
  },
  {
    msg: "[!] Filerne er installeret, men forbindelsen er IKKE bekræftet. Se diagnosen ovenfor; installationen er ikke fuldt bekræftet.",
    sev: "advarsel",
    where: "TRIN 8",
    means: "Kontrollen lykkedes ikke – typisk fordi Revit og en projektfil ikke var åbne og klar inden for 180 sekunder, eller fordi en dialog blokerede. Filerne ER installeret. Linjen over viser årsagen (fx \"Live Revit verification timed out: …\").",
    todo: "Åbn Revit og et projekt, og tjek ISSANA MCP → MCP-panel: status skal være \"MCP Online\". Test derefter fra AI-appen med get_connection_status. Vil du have en ny automatisk kontrol, så luk Revit og kør installationsfilen igen (vælg R).",
  },
];

const messageGroups: MsgGroup[] = [
  {
    id: "fejl-exe",
    title: "Installationsvinduet (før konsolvinduet)",
    intro: "Under den danske tekst står en detalje – som regel på engelsk, men Windows-fejl kan stå på dansk.",
    items: [
      {
        msg: "Installationen kunne ikke startes. Ingen Revit-filer blev ændret af launcheren.",
        sev: "fejl",
        where: "Boksen \"ISSANA — installationsfejl\"",
        means: "Installationsfilen kunne ikke pakke sine filer ud i %TEMP%, kontrollere dem eller starte konsolvinduet. Under teksten står en detalje (se de næste punkter).",
        todo: "Hent filen igen (downloaden kan være ufuldstændig), sørg for fri diskplads, og tjek at antivirus ikke blokerer %TEMP%. Send et skærmbillede af boksen, hvis fejlen gentager sig.",
      },
      {
        msg: "Installer payload is missing. / Unsafe payload path: <sti> / manifest.sha256 is missing. / Invalid manifest line: <linje> / Unsafe manifest path. / Payload file is missing: <sti> / Payload hash mismatch: <sti> / Payload contains files not covered by the manifest.",
        sev: "fejl",
        means: "Installationsfilen er ufuldstændig eller ændret – typisk en afbrudt download eller antivirus.",
        todo: "Hent filen igen fra denne side, tjek antivirus-karantæne, og kør den igen. Send et skærmbillede til ISSANA, hvis fejlen gentager sig.",
      },
      { msg: "Could not start INSTALLA.bat.", sev: "fejl", means: "Windows startede ikke konsolvinduet (sjælden intern fejl). Blokerer IT-regler cmd.exe, står der i stedet en Windows-fejltekst, fx om gruppepolitik.", todo: "Kør installationsfilen igen. Står der en tekst om fx gruppepolitik, så brug en pc, hvor du må køre programmer, eller kontakt IT." },
      { msg: "ISSANA logo resource is missing.", sev: "fejl", where: "Ingen boks", means: "Installationsfilen lukker uden nogen besked (defekt build). Teksten ses kun i Logbog → Windows-logfiler → Program (kilde .NET Runtime).", todo: "Hent filen igen, og kontakt ISSANA." },
    ],
  },
  {
    id: "fejl-trin1",
    title: "TRIN 1 – Systemtjek",

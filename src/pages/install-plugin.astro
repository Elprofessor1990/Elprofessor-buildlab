  { k: "head", t: "  TRIN 1  --  Systemtjek" },
  { k: "ok", t: "  [+] PowerShell 5.1.26100.9444" },
  { k: "ok", t: "  [+] Windows 10.0 build 26200" },
  { k: "step", t: "  [*] Tester internetforbindelsen..." },
  { k: "ok", t: "  [+] Internetforbindelse OK" },

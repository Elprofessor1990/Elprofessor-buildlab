const r = String.raw;
const installerFile = "ISSANA-Revit-MCP-NBS-Installer.exe";
const installerUrl = getAssetPath(`downloads/${installerFile}`);
/* Den gemte fil får versionen i navnet (download-attributten; samme domæne). */
const savedFile = `ISSANA-Revit-MCP-NBS-Installer-${pluginVersion}.exe`;
const architectureUrl = getAssetPath("assets/revit-nbs-integration-architecture.png");
const claudeUrl = "https://claude.com/download";
const codexUrl = "https://openai.com/da-DK/codex/";
const issana = "ISSANA — Rådgivende Ingeniører";

const toc = [
  { href: "#foer-du-starter", label: "Før du starter" },
  { href: "#installer", label: "Installér" },
  { href: "#kontroller", label: "Kontrollér" },
  { href: "#nbs", label: "Forbind NBS Nordic" },
  { href: "#fejl", label: "Fejl og løsninger" },
  { href: "#oevelser", label: "Øvelser" },
  { href: "#manuel", label: "Manuel opsætning" },
];


      { msg: "[-] Installation af Node.js fejlede: <fejltekst>\n    Installér manuelt: https://nodejs.org", sev: "fejl", means: "Node.js kunne ikke slås op eller hentes fra nodejs.org (netværk, proxy eller firewall). Fejlteksten kommer fra PowerShell.", todo: "Installér Node.js LTS manuelt fra nodejs.org, og kør derefter installationsfilen igen." },
      { msg: "[!] Springer Node.js over  --  installér senere fra https://nodejs.org", sev: "advarsel", means: "Du valgte 2, trykkede Enter eller svarede andet end 1 og 3. Pluginet installeres, men AI-apps viser \"Fejlede\" i TRIN 9, og TRIN 8 mislykkes.", todo: "Installér Node.js LTS, og kør installationsfilen igen." },
      { msg: "[+] Node.js <version> (medfølgende runtime -- ingen systeminstallation nødvendig)", sev: "info", means: "Node.js findes ikke på pc'en, men en gammel node.exe fra en ældre version ligger stadig i Addins-mappen.", todo: "Intet, men installér gerne Node.js LTS." },
    ],
  },
  {
    id: "fejl-trin56",
    title: "TRIN 5–6 – Kopiering af filer",
    intro: "Detaljen efter \"Lokal installation fejlede:\" står ofte på engelsk.",
    items: [
      { msg: "[!] Revit <år> fundet, men pakken indeholder ikke den version -- springes over.", sev: "advarsel", means: "Der er fundet Revit 2023–2025 (eller en tom Addins-mappe fra et andet plugin). Pakken indeholder kun 2026 og 2027.", todo: "Intet, hvis Revit 2026 eller 2027 også er fundet." },
      { msg: "[-] Lokal installation fejlede: Ingen fundet Revit-version passer til pakken. Versioner i pakken: 2026, 2027.", sev: "fejl", means: "Kun Revit 2023–2025 er installeret.", todo: "Installér Revit 2026 eller 2027." },
      { msg: "[-] Lokal installation fejlede: Revit is running; refusing to replace DLLs.", sev: "fejl", means: "Revit blev startet, mens installeren kopierede filer.", todo: "Luk Revit, og kør installationsfilen igen." },
      { msg: "[-] Lokal installation fejlede: Incomplete local Revit <år> package: <fil>", sev: "fejl", means: "Pakken mangler en plugin-fil (defekt build).", todo: "Hent filen igen, og kontakt ISSANA." },
      { msg: "[-] Lokal installation fejlede: Missing local artifact: <sti>", sev: "fejl", means: "En fil i pakken mangler.", todo: "Hent filen igen." },
      { msg: "[-] Lokal installation fejlede: Unsafe target path.", sev: "fejl", means: "En målsti ville havne uden for Addins-mappen.", todo: "Kontakt ISSANA med et skærmbillede." },
      { msg: "[-] Lokal installation fejlede: Reparse point in target: <sti>", sev: "fejl", means: "Addins-mappen eller en overmappe er et symlink/junction (fx omdirigeret AppData).", todo: "Kontakt underviseren eller IT med et skærmbillede." },

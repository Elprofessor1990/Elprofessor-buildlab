      { msg: "[!] Eksisterende installation fundet for Revit <år>", sev: "advarsel", means: "Pluginet er allerede installeret – en tidligere ISSANA-version eller det oprindelige mcp-servers-for-revit.", todo: "Tryk Enter (= R, Erstat) ved spørgsmålet \"Vælg [R/s/a]:\" for at opdatere." },
      { msg: "[*] Erstatter eksisterende installation.", sev: "info", means: "Du valgte R (eller trykkede Enter).", todo: "Intet." },

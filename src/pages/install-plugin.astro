                        <dt>Betyder</dt>
                        <dd>{m.means}</dd>
                        <dt>Gør sådan</dt>
                        <dd>{m.todo}</dd>
                      </dl>
                    </details>
                  ))}
                </div>
              </div>
            </details>
          ))
        }
      </div>
      <p class="ip-note">
        <strong>Stadig fast?</strong> Tag et skærmbillede af hele konsolvinduet, og oplys versionen ({pluginVersion}), når du beder om
        hjælp.
      </p>
    </section>

    <!-- 6. Øvelser -->
    <section class="ip-section" id="oevelser" aria-labelledby="oevelser-title">
      <div class="ip-section__head">

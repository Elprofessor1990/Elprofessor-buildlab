      { msg: "[-] PowerShell 5.1 eller nyere kræves (fundet <version>).\n    Opdatér: https://aka.ms/wmf5download", sev: "fejl", means: "PowerShell er for gammel. Ses næsten aldrig, fordi Windows 10/11 altid har PowerShell 5.1.", todo: "Opdatér Windows." },
      { msg: "[-] Windows 10 eller nyere kræves.", sev: "fejl", means: "Pc'en kører Windows 8.1 eller ældre.", todo: "Brug en pc med Windows 10 eller 11." },
    ],
  },
  {
    id: "fejl-trin2",
    title: "TRIN 2 – Revit",
    items: [
      { msg: "[-] Ingen Revit-installation fundet (tjekket 2023-2027).", sev: "fejl", means: r`Installeren fandt ingen Revit 2023–2027 – hverken i Windows' registreringsdatabase, som Addins-mappe eller som C:\Program Files\Autodesk\Revit <år>\Revit.exe.`, todo: "Installér Revit 2026 eller 2027 (gerne i standardmappen), og kør installationsfilen igen." },
      { msg: r`Brug -RevitVersion for at vælge selv: .\install.ps1 -RevitVersion 2025`, sev: "info", means: "Et tip til udviklere. Du kan ikke give parametre til installationsfilen, og Revit 2025 er ikke i pakken.", todo: "Ignorér linjen, og følg rådet ved fejlen ovenfor." },

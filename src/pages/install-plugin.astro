    items: [
      { msg: "<Klient>: Ikke installeret -- sprunget over", sev: "info", means: "Appen blev ikke fundet. Claude Code kræver kommandoen claude, Codex kræver kommandoen codex eller Codex-appen, og Claude Desktop kræver Claude-appen.", todo: "Normalt intet. Har du appen, så installér eller genstart den, og kør installationsfilen igen." },

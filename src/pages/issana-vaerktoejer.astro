---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAssetPath } from '../i18n';
import guide from '../data/issanaVerifiedTools.json';
const groups=[...new Set(guide.tools.map(t=>t.group))].sort((a,b)=>a.localeCompare(b,'da'));
---
<BaseLayout locale="da" currentPage="plugin" title="ISSANA MCP — værktøjer i praksis" description="Rigtige værktøjsbilleder, korte vejledninger og det faktiske MCP-katalog fra ISSANA 3.10.">
  <main class="tool-guide">
    <a class="back" href={getAssetPath('install-plugin')}>← Installation og hjælp</a>
    <header class="hero">
      <div><p class="eyebrow">ISSANA / VÆRKTØJSBOG 01</p><h1>Find dit<br/><em>næste værktøj.</em></h1><p class="intro">Se vinduet. Forstå opgaven. Kontrollér resultatet.</p></div>
      <div class="edition"><strong>3.10</strong><p>Kontrol: 18. november 2026<br/>Revit 2027 · lokal testkopi</p><a href="#mcp">195 MCP-værktøjer ↓</a><a href="#billeder">24 billeder fra programmet ↓</a></div>
    </header>
    <aside class="scope"><strong>Sådan læses kontrollen.</strong> Billederne viser det installerede program. Teksten under hvert billede fortæller præcis, hvad der blev prøvet. At et vindue åbner, godkender ikke en beregning eller alle funktioner. Ren pc og Revit 2026.5 mangler stadig en liveprøve.</aside>
    <section id="billeder" aria-labelledby="image-title">
      <div class="section-head"><span>01 / I REVIT</span><h2 id="image-title">Vinduet og din arbejdsgang.</h2></div>
      <div class="gallery">{guide.gallery.map((item,i)=><article class="tool-card">
        <div class="card-head"><span>{String(i+1).padStart(2,'0')} / {item.area}</span><h3>{item.title}</h3></div>
        <a class="picture" href={getAssetPath('assets/issana-mcp/verified/'+item.image)} target="_blank" rel="noopener" aria-label={'Åbn større billede af '+item.title}><img src={getAssetPath('assets/issana-mcp/verified/'+item.image)} alt={item.title+' i ISSANA MCP 3.10, kontrolleret i Revit 2027'} loading="lazy" width="1100" height="800"/></a>
        <div class="card-copy"><p>{item.how}</p><p class="tested"><strong>Kontrolleret:</strong> {item.tested}</p></div>
      </article>)}</div>
    </section>
    <section id="mcp" aria-labelledby="mcp-title">
      <div class="section-head"><span>02 / GENNEM AI-APPEN</span><h2 id="mcp-title">Det faktiske værktøjskatalog.</h2></div>
      <p>Start med <code>get_connection_status</code>. Bed derefter AI’en finde et værktøj til din opgave med <code>find_tools</code>. Brug posterne nedenfor til at se de felter, værktøjet forventer. Tekniske navne og værktøjets egen beskrivelse er bevaret, så opslaget passer til MCP.</p>
      <p class="muted">{guide.scope} Listen er hentet gennem MCP den 18. november 2026. Alle 195 er fundet; de er ikke alle udført enkeltvis.</p>
      <div class="filters"><label>Søg i værktøjer<input id="tool-search" type="search" placeholder="Fx materialer, family eller skema" /></label><label>Område<select id="tool-group"><option value="">Alle områder</option>{groups.map(g=><option value={g}>{g}</option>)}</select></label><p id="tool-count" role="status" aria-live="polite">195 værktøjer</p></div>
      <div id="tool-list">{guide.tools.map(t=><details class="mcp-tool" data-group={t.group} data-search={(t.name+' '+t.group+' '+t.description).toLocaleLowerCase('da')}>
        <summary><span><small>{t.group}</small><code>{t.name}</code></span><span aria-hidden="true">+</span></summary>
        <div class="tool-content"><p>{t.description}</p><h3>Felter til kaldet</h3>{t.fields.length?<div class="table-scroll"><table><thead><tr><th>Felt</th><th>Skal udfyldes?</th><th>Type og betydning</th></tr></thead><tbody>{t.fields.map(f=><tr><td><code>{f.name}</code></td><td>{f.required?'Ja':'Valgfrit'}</td><td><strong>{f.type}</strong> · {f.description}</td></tr>)}</tbody></table></div>:<p>Ingen indtastningsfelter er defineret.</p>}<p class="muted">Kontrollér model og input først. Hvis kaldet ændrer modellen, gennemgå forslaget og brug en testkopi.</p></div>
      </details>)}</div>
      <p id="no-tools" hidden>Ingen værktøjer matcher. Prøv et andet ord eller vælg Alle områder.</p>
    </section>
  </main>
</BaseLayout>
<script>
const search=document.querySelector<HTMLInputElement>('#tool-search');
const group=document.querySelector<HTMLSelectElement>('#tool-group');
const rows=[...document.querySelectorAll<HTMLDetailsElement>('.mcp-tool')];
function filter(){const q=(search?.value||'').trim().toLocaleLowerCase('da');let count=0;for(const row of rows){row.hidden=!(row.dataset.search?.includes(q)&&(!group?.value||row.dataset.group===group.value));if(!row.hidden)count++;}const status=document.querySelector('#tool-count');if(status)status.textContent=count+' af '+rows.length+' værktøjer';const empty=document.querySelector<HTMLElement>('#no-tools');if(empty)empty.hidden=count!==0;}
search?.addEventListener('input',filter);group?.addEventListener('change',filter);
</script>
<style>
:global(body:has(.tool-guide)){min-width:0}
.tool-guide{max-width:1180px;margin:auto;padding:2rem 1.4rem 6rem;color:#112a46}.back{display:inline-block;margin:1rem 0 2.8rem;text-decoration:none}.hero{display:grid;grid-template-columns:1fr 260px;gap:3rem;align-items:end;border-bottom:3px solid #112a46;padding-bottom:2.6rem}.eyebrow,.section-head>span,.card-head>span{font-size:.75rem;font-weight:700;letter-spacing:.12em}.hero h1{font-size:clamp(2.8rem,6vw,5rem);line-height:1.04;letter-spacing:-.05em;margin:1rem 0}.hero em{font-style:normal;color:#c75b12}.intro{font-size:1.2rem}.edition{padding:1.4rem;border-left:5px solid #f28c28;background:#f5f2ea}.edition>strong{font-size:3rem}.edition a{display:block;margin-top:1rem;font-weight:650}.scope{background:#e8f3ef;padding:1.4rem 1.7rem;margin:2rem 0;line-height:1.7}.section-head{margin:4rem 0 1.5rem}.section-head>span{color:#a24e15}.section-head h2{font-size:clamp(1.7rem,3vw,2.4rem);letter-spacing:-.035em;margin:.5rem 0}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:1.8rem}.tool-card{background:#fff;border:1px solid #cbd3d6;min-width:0}.card-head{padding:1.3rem 1.4rem .8rem}.card-head>span{font-size:.65rem;letter-spacing:.07em;color:#52646e}.card-head h3{font-size:1.5rem;margin:.45rem 0}.picture{display:flex;align-items:center;justify-content:center;min-height:180px;height:320px;background:#edf0ec;border-block:1px solid #e1e5e4;padding:10px}.picture img{width:100%;height:100%;object-fit:contain}.card-copy{padding:1rem 1.4rem;line-height:1.6;font-size:.95rem}.card-copy p:first-child{margin-top:0}.tested{border-top:1px solid #d9dfdf;padding-top:.8rem;color:#3d555a;font-size:.88rem}.muted{color:#52646e;font-size:.9rem;line-height:1.65}.filters{display:grid;grid-template-columns:2fr 1fr auto;gap:1rem;align-items:end;background:#f5f2ea;padding:1.4rem;margin:1.7rem 0}.filters label{font-size:.8rem;font-weight:650}.filters input,.filters select{display:block;width:100%;padding:.75rem;background:#fff;border:1px solid #8b9da6;margin-top:.5rem;border-radius:0;color:#112a46;font-size:1rem}.filters p{font-size:.85rem;white-space:nowrap}.mcp-tool{border-top:1px solid #b8c6cc}.mcp-tool[hidden]{display:none}.mcp-tool summary{display:flex;justify-content:space-between;cursor:pointer;gap:1rem;padding:1.2rem .5rem;list-style:none}.mcp-tool summary small{display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.07em;color:#52646e;margin-bottom:.35rem}.mcp-tool summary code{font-size:.95rem;overflow-wrap:anywhere}.mcp-tool[open]{background:#f5f8f7}.tool-content{padding:.2rem 1.4rem 1.2rem;line-height:1.65}.tool-content>p{white-space:pre-wrap;overflow-wrap:anywhere}.table-scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:.85rem}td,th{text-align:left;vertical-align:top;padding:.7rem;border-bottom:1px solid #d7dfdf}td code{overflow-wrap:anywhere}th{background:#e4edeb}h3{font-size:1.05rem}a:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #c75b12;outline-offset:4px}@media(max-width:720px){.hero{grid-template-columns:1fr;gap:1rem}.edition{max-width:100%}.edition>strong{font-size:2rem}.gallery{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.picture{height:280px}.tool-guide{padding-inline:1rem}.hero h1{font-size:3.2rem}}@media(prefers-reduced-motion:no-preference){.picture img{transition:transform .2s}.picture:hover img{transform:scale(1.015)}}
</style>

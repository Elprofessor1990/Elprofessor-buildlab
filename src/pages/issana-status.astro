---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAssetPath, withBase } from "../i18n";
import { releaseStatus, candidateFeatures, remainingWork } from "../data/issanaRelease";
---
<BaseLayout locale="da" currentPage="plugin" title="ISSANA MCP — nye funktioner og næste udgave" description="Se scriptbiblioteket, de nye fagforløb og det, der mangler før næste ISSANA MCP-udgivelse.">
  <div class="release-page">
    <header class="release-hero">
      <a class="back" href={withBase("/install-plugin")}>← Installation og vejledning</a>
      <p class="eyebrow">ISSANA MCP · Status {releaseStatus.checked}</p>
      <h1>Fra model til et resultat,<br /> du kan forstå.</h1>
      <p class="intro">Mere overskuelige forløb i 3D, data at øve med og et bibliotek til dine egne scripts. Her kan du se, hvad der kan hentes nu, og hvad vi arbejder på at få klar.</p>
      <div class="release-summary">
        <div><span class="label">Kan hentes nu</span><strong>{releaseStatus.publicVersion}</strong><p>Offentlig testversion · Windows · Revit 2026/2027 · 143 MB</p><a class="button button--primary" href={releaseStatus.download}>Hent den offentlige testversion</a></div>
        <div><span class="label">Næste udgave</span><strong>Under afprøvning</strong><p>De nye funktioner nedenfor er endnu ikke med i den offentlige download. En samlet prøve i Revit og AI-apps mangler.</p><a class="text-link" href="#mangler">Se hvad der mangler →</a></div>
      </div>
    </header>

    <section class="script-section" aria-labelledby="scripts-title">
      <div class="section-intro"><p class="eyebrow">Bygget · endnu ikke udgivet</p><h2 id="scripts-title">Dit eget scriptværksted</h2><p>Et roligt arbejdsrum med kode i midten og biblioteket ved siden af. Begynd med et eksempel, ret det, og gem det som dit eget lille værktøj.</p></div>
      <figure><a href={getAssetPath("assets/issana-mcp/script-library-preview.png")} aria-label="Åbn billedet af scriptbiblioteket i fuld størrelse"><img src={getAssetPath("assets/issana-mcp/script-library-preview.png")} width="1180" height="820" alt="ISSANAs nye scriptbibliotek med Python- og C#-eksempler til venstre, kodefelt og knapperne Kør kode, Kontrollér og Gem." loading="lazy" /></a><figcaption>Det rigtige vindue i en isoleret test. Revit er simuleret på billedet; der er ikke ændret en projektmodel.</figcaption></figure>
      <ol class="script-steps"><li><strong>Vælg eller skriv</strong><span>Find et eksempel, et gemt script eller begynd med hurtig kode.</span></li><li><strong>Forstå og tilpas</strong><span>Ret koden og kontrollér den. Python bruger IronPython; almindelige native pip-pakker er ikke understøttet.</span></li><li><strong>Kør og gem</strong><span>Se resultatet, og gem en .py- eller .cs-fil i dit eget bibliotek.</span></li></ol>
      <p class="note">Scripts er lokal kode med adgang til pc'ens filer og net. Læs dem før kørsel. Revit-broen har i første udgave et lille sæt funktioner; den giver ikke fri adgang til hele Revit API'et.</p>
    </section>

    <section aria-labelledby="features-title"><div class="section-intro"><p class="eyebrow">På vej</p><h2 id="features-title">Det nye, og hvor langt det er</h2><p>En bygget funktion skal også prøves i et rigtigt arbejdsforløb. Status gælder {releaseStatus.checked}.</p></div><div class="feature-grid">{candidateFeatures.map((feature) => <article><p class="status">{feature.status}</p><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div></section>

    <section id="mangler" aria-labelledby="remaining-title"><div class="section-intro"><p class="eyebrow">Vejen til næste udgave</p><h2 id="remaining-title">Det, der reelt mangler</h2><p>Første prioritet er at samle ændringerne og bevise, at den samme version virker hele vejen fra installation til resultat.</p></div><ol class="remaining">{remainingWork.map((item, index) => <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p class="done">{item.done}</p><p>{item.next}</p></div></li>)}</ol></section>

    <section class="installation" aria-labelledby="config-title"><div class="section-intro"><p class="eyebrow">Installation uden manuel kopiering</p><h2 id="config-title">EXE-filen skal sætte MCP op</h2><p>Installér og log ind i den AI-app, du vil bruge, før du kører ISSANA-installeren. Installeren sætter de fundne klienter op; den installerer ikke selve Claude eller Codex.</p></div><div class="client-grid"><article><h3>Claude Code</h3><p>Forbindelsen registreres for din bruger. Standardplaceringen er <code>%USERPROFILE%\.claude.json</code>.</p><a href="https://code.claude.com/docs/en/mcp" target="_blank" rel="noopener">Claude Codes MCP-vejledning ↗</a></article><article><h3>Codex</h3><p>Forbindelsen lægges i Codex' konfiguration. Standardplaceringen er <code>%USERPROFILE%\.codex\config.toml</code>.</p><a href="https://learn.chatgpt.com/docs/extend/mcp?surface=cli" target="_blank" rel="noopener">Codex' MCP-vejledning ↗</a></article></div><p>Eksisterende indstillinger skal bevares, og installeren tager backup, når den ændrer konfigurationen. Læs slutstatus for hver app, genstart klienten efter behov, og kontrollér forbindelsen til en åben Revit-model. En oprettet config-fil er kun ét trin i den kontrol.</p><p class="note">Den offentlige fil er hentet og kontrolleret den {releaseStatus.checked}. En frisk installation af den nye kandidat på en student-pc er fortsat et åbent testpunkt. Installationsfilerne er endnu ikke signeret med Authenticode.</p><details><summary>Downloadoplysninger og filkontrol</summary><dl><dt>Fil</dt><dd>ISSANA-MCP-Installer-3.0.9-test.exe</dd><dt>Størrelse</dt><dd>{releaseStatus.bytes.toLocaleString("da-DK")} bytes</dd><dt>SHA-256</dt><dd class="hash">{releaseStatus.sha256}</dd></dl><p><a href={releaseStatus.release}>Se udgivelsen på GitHub →</a></p><p>Den offentlige EXE har 193 filer med korrekte SHA-256-kontrolsummer. Den nye kandidat har bestået 109 kontroller af klientopsætningen i isolerede profiler samt pakke- og udpakningskontrol. Disse prøver er ikke en fuld installation på en student-pc.</p></details><a class="button" href={withBase("/install-plugin")}>Se hele installationsvejledningen</a></section>
  </div>
</BaseLayout>
<style>
  .button{display:inline-flex;align-items:center;justify-content:center;border:1px solid #b7ccca;border-radius:10px;padding:.8rem 1.1rem;font-weight:700;text-decoration:none;background:white;color:#112a46}.button--primary{background:#f28c28;border-color:#f28c28;color:#112a46}.button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #f28c28;outline-offset:4px}.release-summary p{color:#d2e4eb}

  .release-page{max-width:1180px;margin:auto;padding:2rem 1.5rem 5rem;color:#112a46}.release-page section{margin-top:5rem}.back{display:inline-block;margin-bottom:2rem;color:#24546a}.eyebrow,.label{font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;font-weight:750}.release-hero h1{font-size:clamp(2.4rem,5vw,4.5rem);line-height:1.08;letter-spacing:-.035em;margin:1rem 0 1.5rem}.intro{max-width:740px;font-size:1.18rem;line-height:1.7}.release-summary{display:grid;grid-template-columns:1fr 1fr;background:#112a46;color:white;border-radius:20px;margin-top:2.5rem;overflow:hidden}.release-summary>div{padding:2rem}.release-summary>div+div{background:#183954}.release-summary .label{display:block;color:#a8ddd0}.release-summary strong{display:block;font-size:1.8rem;margin:.65rem 0}.release-summary p{max-width:460px;line-height:1.6}.release-summary .text-link{color:#a8e3d4}.section-intro{max-width:760px;margin-bottom:1.75rem}.section-intro h2{font-size:clamp(1.7rem,3vw,2.4rem);letter-spacing:-.025em;margin:.5rem 0 1rem}.section-intro p,.feature-grid p,.remaining p,.installation p{line-height:1.65}.script-section figure{margin:0;border:1px solid #d8e4df;border-radius:16px;overflow:hidden;background:#f4f6f3}.script-section img{display:block;width:100%;height:auto}.script-section figcaption{padding:1rem 1.3rem;font-size:.85rem;color:#42605a;border-top:1px solid #d8e4df}.script-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;list-style:none;padding:0;margin:2rem 0}.script-steps strong,.script-steps span{display:block}.script-steps strong{margin-bottom:.6rem}.script-steps span{line-height:1.6}.note{background:#f5f2ea;border-left:3px solid #f28c28;padding:1rem 1.3rem;line-height:1.6;border-radius:0 8px 8px 0}.feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.feature-grid article{border:1px solid #dbe3e7;padding:1.6rem;border-radius:12px}.feature-grid h3{font-size:1.3rem;margin:.8rem 0}.feature-grid p:last-child{margin-bottom:0}.status{color:#35625b;font-size:.8rem;font-weight:700;margin:0}.remaining{list-style:none;padding:0;display:grid;gap:0}.remaining li{display:grid;grid-template-columns:64px 1fr;gap:1rem;border-top:1px solid #dbe3e7;padding:1.6rem 0}.step-number{font-size:1.5rem;color:#3e7770}.remaining h3{font-size:1.2rem;margin:.1rem 0 .6rem}.remaining p{margin:.5rem 0}.done{color:#476473;font-size:.9rem}.installation{background:#f4f6f5;border-radius:20px;padding:2.2rem}.client-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.6rem}.client-grid article{background:white;padding:1.5rem;border-radius:12px}.client-grid h3{margin-top:0}.client-grid a{font-size:.9rem;color:#135e5b}.installation code,.hash{overflow-wrap:anywhere}.installation details{margin:1.5rem 0}.installation summary{cursor:pointer;font-weight:700}.installation dl{display:grid;grid-template-columns:90px 1fr;gap:.8rem}.installation dd{margin:0}.installation .hash{font-family:monospace;font-size:.85rem}.installation .button{margin-top:.5rem}
  @media(max-width:700px){.release-page{padding:1rem 1rem 3rem}.release-page section{margin-top:3rem}.release-summary,.feature-grid,.client-grid,.script-steps{grid-template-columns:1fr}.release-summary>div{padding:1.5rem}.installation{padding:1.2rem}.remaining li{grid-template-columns:38px 1fr;gap:.5rem}.script-steps{gap:1.2rem}.release-hero h1 br{display:none}}
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../i18n";
const guideUrl = withBase("/install-plugin/");
---
<BaseLayout locale="da" currentPage="plugin" title="ISSANA MCP — samlet vejledning">
  <section style="max-width:800px;margin:4rem auto;padding:0 1.5rem">
    <h1>ISSANA har fået én samlet guide.</h1>
    <p>Installation, hjælp og nye funktioner er samlet i tre faner.</p>
    <a id="issana-guide-link" href={`${guideUrl}#nye-funktioner`} data-guide-url={guideUrl} style="text-decoration:underline">Åbn ISSANA-guiden →</a>
  </section>
</BaseLayout>
<script>
  const link = document.getElementById("issana-guide-link") as HTMLAnchorElement | null;
  if (link?.dataset.guideUrl) {
    const target = `${link.dataset.guideUrl}${window.location.hash || "#nye-funktioner"}`;
    link.href = target;
    window.location.replace(target);
  }
</script>
